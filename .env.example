# ──────────────────────────────────────────────────────────────────────
# Tranding — environment variables
# Copy this file to `.env` and fill in the blanks.
# ──────────────────────────────────────────────────────────────────────

# Database (MySQL). The `docker-compose.yml` in this repo spins up a local
# instance matching this URL.
DATABASE_URL="mysql://tranding:tranding@localhost:3306/tranding"

# Auth.js / NextAuth
# Generate: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-32-byte-random-string"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Disable registration after the first user is created.
ALLOW_REGISTRATION="true"

# Encryption key for stored API keys (AES-256-GCM, hashed to 32 bytes).
# Generate: openssl rand -hex 32
ENCRYPTION_KEY="change-me-to-a-long-random-string-32+chars"

# ──────────────────────────────────────────────────────────────────────
# 3rd-party API keys (optional at boot — can also be added via Settings).
# ──────────────────────────────────────────────────────────────────────

# Google Gemini — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# Twelve Data (forex + crypto prices) — https://twelvedata.com/
TWELVE_DATA_API_KEY=""

# CryptoPanic news aggregator — https://cryptopanic.com/developers/api/
CRYPTOPANIC_API_KEY=""

# Etherscan / BscScan
ETHERSCAN_API_KEY=""
BSCSCAN_API_KEY=""
