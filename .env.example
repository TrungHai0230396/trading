# ──────────────────────────────────────────────────────────────────────
# Tranding — environment variables
# Copy this file to `.env` and fill in the blanks.
# Lines marked [PROD] MUST be changed before a public deployment.
# ──────────────────────────────────────────────────────────────────────

# ── Database (MySQL via docker-compose) ───────────────────────────────
# DATABASE_URL is what the HOST uses (prisma migrate/studio). The app
# CONTAINER builds its own URL from MYSQL_* below and the `mysql` host.
DATABASE_URL="mysql://tranding:tranding@localhost:3306/tranding"

# [PROD] Set strong unique values — compose falls back to weak defaults
# (rootpass/tranding) when these are unset. Update DATABASE_URL to match.
MYSQL_ROOT_PASSWORD="rootpass"
MYSQL_USER="tranding"
MYSQL_PASSWORD="tranding"
MYSQL_DATABASE="tranding"

# How many days of nightly DB backups the sidecar keeps in ./backups.
DB_BACKUP_KEEP_DAYS="7"

# ── Auth.js / NextAuth ─────────────────────────────────────────────────
# [PROD] Generate a fresh one: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-32-byte-random-string"
# [PROD] MUST be the public https origin (e.g. https://tranding.example.com)
# — leaving localhost breaks Google login for everyone on the VPS.
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Google OAuth (create at https://console.cloud.google.com/apis/credentials,
# redirect URI: <AUTH_URL>/api/auth/callback/google).
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# "true" = Google is the ONLY login (password forms hidden, signup closed).
# Fails CLOSED if the two creds above are missing.
AUTH_GOOGLE_ONLY="true"

# Password registration switch — irrelevant while AUTH_GOOGLE_ONLY=true.
ALLOW_REGISTRATION="true"

# [PROD] Set true ONLY behind a reverse proxy that overwrites
# x-forwarded-for (Caddy/nginx) — enables per-IP rate limiting.
TRUST_PROXY="false"

# ── Access control ─────────────────────────────────────────────────────
# [PROD] Emails allowed to place/cancel/close REAL orders (comma-separated).
# Everyone else is read-only. Also the default admin list.
AUTOTRADE_ALLOWED_EMAILS=""
# Who can open /admin (falls back to AUTOTRADE_ALLOWED_EMAILS when unset).
ADMIN_EMAILS=""
# Global kill-switch for real-money order placement.
BITGET_AUTOPLACE_ENABLED="false"

# ── Encryption ─────────────────────────────────────────────────────────
# [PROD] AES-256-GCM key for stored exchange API keys. Losing it = every
# user must reconnect their brokers. Generate: openssl rand -hex 32
ENCRYPTION_KEY="change-me-to-a-long-random-string-32+chars"

# ── Cron tuning ────────────────────────────────────────────────────────
# Set true for one-off maintenance runs (e.g. during a DB restore).
# CRON_DISABLED="true"
# Max users refreshed per hourly news tick (Gemini cost guard).
# NEWS_REFRESH_MAX_USERS="10"

# ──────────────────────────────────────────────────────────────────────
# 3rd-party API keys (optional — features degrade gracefully without them)
# ──────────────────────────────────────────────────────────────────────

# Google Gemini (news summaries + AI narrative) — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# Twelve Data (forex prices for calculator/journal) — https://twelvedata.com/
TWELVE_DATA_API_KEY=""

# CryptoPanic news aggregator — https://cryptopanic.com/developers/api/
CRYPTOPANIC_API_KEY=""

# Etherscan / BscScan
ETHERSCAN_API_KEY=""
BSCSCAN_API_KEY=""
